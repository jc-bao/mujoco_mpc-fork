    <body name="left_box_front" mocap="true" pos="0.075  0.25 -0.14">
      <geom name="left_box_front" type="box" size="0.021 0.021 0.005" rgba="1 .1 .1 1.0" />
    </body>

    <body name="left_box_back" mocap="true" pos="-0.075  0.25 -0.14">
      <geom name="left_box_back" type="box" size="0.021 0.021 0.005" rgba="1 .1 .1 1.0" />
    </body>

    <body name="right_box_front" mocap="true" pos="0.075  0.25 -0.14">  
      <geom name="right_box_front" type="box" size="0.021 0.021 0.005" rgba="1 .1 .1 1.0" />
    </body>

    <body name="right_box_back" mocap="true" pos="-0.075  0.25 -0.14">
      <geom name="right_box_back" type="box" size="0.021 0.021 0.005" rgba="1 .1 .1 1.0" />
    </body>
  </worldbody>

  <actuator>
    <position class="hip_yaw_motor" name="left_hip_yaw_joint" joint="left_hip_yaw_joint" />
    <position class="hip_roll_motor" name="left_hip_roll_joint" joint="left_hip_roll_joint" />
    <position class="hip_pitch_motor" name="left_hip_pitch_joint" joint="left_hip_pitch_joint" />

    <position class="knee_motor" name="left_knee_joint" joint="left_knee_joint" />
    <position class="ankle_pitch_motor" name="left_ankle_joint"
      joint="left_ankle_joint" />

    <position class="hip_yaw_motor" name="right_hip_yaw_joint" joint="right_hip_yaw_joint" />
    <position class="hip_roll_motor" name="right_hip_roll_joint" joint="right_hip_roll_joint" />
    <position class="hip_pitch_motor" name="right_hip_pitch_joint" joint="right_hip_pitch_joint" />

    <position class="knee_motor" name="right_knee_joint" joint="right_knee_joint" />
    <position class="ankle_pitch_motor" name="right_ankle_joint"
      joint="right_ankle_joint" />

    <position class="torso_motor" name="torso_joint" joint="torso_joint" />

    <position class="shoulder_pitch_motor" name="left_shoulder_pitch_joint"
      joint="left_shoulder_pitch_joint" />
    <position class="left_shoulder_roll_motor" name="left_shoulder_roll_joint"
      joint="left_shoulder_roll_joint" />
    <position class="left_shoulder_yaw_motor" name="left_shoulder_yaw_joint"
      joint="left_shoulder_yaw_joint" />
    <position class="elbow_motor" name="left_elbow_joint" joint="left_elbow_joint" />
    <position class="shoulder_pitch_motor" name="right_shoulder_pitch_joint"
      joint="right_shoulder_pitch_joint" />
    <position class="right_shoulder_roll_motor" name="right_shoulder_roll_joint"
      joint="right_shoulder_roll_joint" />
    <position class="right_shoulder_yaw_motor" name="right_shoulder_yaw_joint"
      joint="right_shoulder_yaw_joint" />
    <position class="elbow_motor" name="right_elbow_joint" joint="right_elbow_joint" />

  </actuator>

