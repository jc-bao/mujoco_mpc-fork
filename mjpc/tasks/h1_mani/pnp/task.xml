<mujoco model="H1 Pick and Place">
  <include file="../../common.xml" />
  <include file="../h1.xml" />
  <size memory="400K" />
  <option timestep="0.002" impratio="100" cone="elliptic" />
  <compiler angle="radian" meshdir=".." autolimits="true" />
  <custom>
    <text name="task_transition" data="Auto|Target1|Target2|Target3" />
    <!-- agent -->
    <numeric name="agent_planner" data="2" />
    <numeric name="agent_horizon" data="0.5" />
    <numeric name="agent_timestep" data="0.02" />
    <numeric name="sampling_spline_points" data="5" />
    <numeric name="sampling_exploration" data="0.05" />
    <numeric name="gradient_spline_points" data="5" />
    <numeric name="residual_Torso" data="1.05 0.7 1.2" />
    <numeric name="residual_UpperBodyPosture" data="0.1 0.0 1.0" />
    <numeric name="residual_HipPitchPosture" data="0.5 0.0 1.0" />
    <numeric name="residual_KneePosture" data="0.5 0.0 1.0" />
    <numeric name="residual_AnklePosture" data="0.0 0.0 1.0" />
    <numeric name="residual_select_Gait" data="0" />
    <text name="residual_list_Gait" data="Stand|Walk" />
    <numeric name="residual_foot_y_distance" data="0.2 0.1 0.3" />
    <numeric name="residual_foot_x_distance" data="0.00 -0.05 0.05" />
    <numeric name="residual_heading" data="0.0 -3.14 3.14" />
    <numeric name="residual_duty_ratio" data="0.5 0.0 1.0" />
    <numeric name="residual_frequency" data="2.4 0.0 5.0" />
    <numeric name="residual_amplitude" data="0.05 0.0 0.1" />
    <numeric name="residual_HipYawRollPosture" data="0.5 0.0 1.0" />
    <numeric name="residual_select_hand_reach_mode" data="0" />
    <text name="residual_list_hand_reach_mode" data="Target1|Target2|Target3|Target4" />
    <!-- estimator -->
    <numeric name="estimator" data="0" />
    <numeric name="estimator_sensor_start" data="8" />
    <numeric name="estimator_number_sensor" data="26" />
    <numeric name="estimator_timestep" data="0.0075" />
    <numeric name="batch_configuration_length" data="3" />
    <numeric name="batch_scale_prior" data="1.0e-3" />
  </custom>

  <sensor>
    <!-- user="[norm_type] [weight] [weight_lower_bound] [weight_upper_bound] [norm_parameters...]" -->
    <user name="Torso Upright" dim="1" user="6 0.5 0 3.0 0.05" />
    <user name="Pelvis Upright" dim="1" user="6 0.0 0 20.0 0.05" />
    <user name="Foot Upright" dim="2" user="6 20.0 0 30.0 0.05" />
    <user name="Ankle Joint Angle" dim="2" user="6 0.0 0 1.0 0.05" />
    <user name="Height" dim="1" user="6 0.5 0 3 0.04" />
    <user name="Torso XY Velocity" dim="2" user="6 0.0 0 0.1 0.04" />
    <user name="Torso Z Velocity" dim="1" user="6 0.0 0 0.1 0.04" />
    <user name="Position" dim="3" user="2 0.0 0 3.0 0.1" />
    <user name="Orientation" dim="4" user="0 0.1 0 0.2" />
    <user name="Gait X" dim="4" user="6 0.3 0 10 0.03" />
    <user name="Gait Y" dim="4" user="6 1.0 0 10 0.03" />
    <user name="Gait Z" dim="4" user="6 1.0 0 30 0.03" />
    <user name="Balance" dim="2" user="2 0.5 0 1.0 0.1" />
    <user name="Effort" dim="19" user="0 0.03 0.0 0.1" />
    <user name="Joint Velocity" dim="19" user="0 6.0 0.0 10.0" />
    <user name="Posture" dim="19" user="0 0.20 0.0 0.3" />
    <user name="Linear Velocity" dim="3" user="0 0.0 0 0.1" />
    <user name="Angular Momentum" dim="3" user="0 0.0 0 0.1" />
    <user name="Hand Reach" dim="12" user="2 0.0 0 0.1 0.01" />
    <!-- <user name="Bring" dim="6" user="2 0.0 0 1 0.003" /> -->
    <framepos name="pelvis" objtype="site" objname="tracking[pelvis]" />
    <framepos name="right_foot_position" objtype="site" objname="foot_right" />
    <framepos name="left_foot_position" objtype="site" objname="foot_left" />
    <framepos name="tracking_pos[ltoe]" objtype="site" objname="tracking[ltoe]" />
    <framepos name="tracking_pos[rtoe]" objtype="site" objname="tracking[rtoe]" />
    <framepos name="tracking_pos[lheel]" objtype="site" objname="tracking[lheel]" />
    <framepos name="tracking_pos[rheel]" objtype="site" objname="tracking[rheel]" />
    <framepos name="right_hand" objtype="site" objname="tracking[rhand]" />
    <framepos name="left_hand" objtype="site" objname="tracking[lhand]" />
    <!-- <jointpos name="abdomen_z" joint="waist_yaw_joint" />
    <jointpos name="abdomen_y" joint="waist_pitch_joint" />
    <jointpos name="abdomen_x" joint="waist_roll_joint" /> -->
    <jointpos name="hip_x_right" joint="right_hip_roll_joint" />
    <jointpos name="hip_z_right" joint="right_hip_yaw_joint" />
    <jointpos name="hip_y_right" joint="right_hip_pitch_joint" />
    <jointpos name="knee_right" joint="right_knee_joint" />
    <jointpos name="ankle_y_right" joint="right_ankle_joint" />
    <!-- <jointpos name="ankle_x_right" joint="right_ankle_roll_joint" /> -->
    <jointpos name="hip_x_left" joint="left_hip_roll_joint" />
    <jointpos name="hip_z_left" joint="left_hip_yaw_joint" />
    <jointpos name="hip_y_left" joint="left_hip_pitch_joint" />
    <jointpos name="knee_left" joint="left_knee_joint" />
    <jointpos name="ankle_y_left" joint="left_ankle_joint" />
    <!-- <jointpos name="ankle_x_left" joint="left_ankle_roll_joint" /> -->
    <jointpos name="shoulder1_right" joint="right_shoulder_pitch_joint" />
    <jointpos name="shoulder2_right" joint="right_shoulder_roll_joint" />
    <jointpos name="elbow_right" joint="right_elbow_joint" />
    <jointpos name="shoulder1_left" joint="left_shoulder_pitch_joint" />
    <jointpos name="shoulder2_left" joint="left_shoulder_roll_joint" />
    <jointpos name="elbow_left" joint="left_elbow_joint" />

    <!-- trace -->
    <framepos name="trace0" objtype="body" objname="torso" />

    <!-- residual -->
    <framepos name="torso_position" objtype="body" objname="torso" />
    <subtreecom name="pelvis_subcom" body="pelvis" />
    <subtreelinvel name="pelvis_subcomvel" body="pelvis" />
    <framepos name="foot_right" objtype="body" objname="right_ankle_link" />
    <framepos name="foot_left" objtype="body" objname="left_ankle_link" />
    <framepos name="pelvis_position" objtype="body" objname="pelvis" />
    <framezaxis name="torso_up" objtype="xbody" objname="torso" />
    <framezaxis name="pelvis_up" objtype="xbody" objname="pelvis" />
    <framezaxis name="foot_right_up" objtype="xbody" objname="right_ankle_link" />
    <framezaxis name="foot_left_up" objtype="xbody" objname="left_ankle_link" />
    <framexaxis name="torso_forward" objtype="xbody" objname="torso" />
    <framexaxis name="pelvis_forward" objtype="xbody" objname="pelvis" />
    <framexaxis name="foot_right_forward" objtype="xbody" objname="right_ankle_link" />
    <framexaxis name="foot_left_forward" objtype="xbody" objname="left_ankle_link" />
    <subtreelinvel name="waist_lower_subcomvel" body="torso" />
    <framelinvel name="torso_velocity" objtype="body" objname="torso" />
    <framelinvel name="foot_right_velocity" objtype="body" objname="right_ankle_link" />
    <framelinvel name="foot_left_velocity" objtype="body" objname="left_ankle_link" />
    <subtreelinvel name="torso_linvel" body="torso" />
    <subtreeangmom name="torso_angmom" body="torso" />

    <!-- manipulation -->
    <framepos name="left_hand_front" objtype="geom" objname="left_hand_front" />
    <framepos name="left_hand_back" objtype="geom" objname="left_hand_back" />
    <framepos name="right_hand_front" objtype="geom" objname="right_hand_front" />
    <framepos name="right_hand_back" objtype="geom" objname="right_hand_back" />
    <framepos name="box1-1" objtype="site" objname="box1-1" />
    <framepos name="box1-2" objtype="site" objname="box1-2" />
    <framepos name="box1-3" objtype="site" objname="box1-3" />
    <framepos name="box1-4" objtype="site" objname="box1-4" />
    <framepos name="box2-1" objtype="site" objname="box2-1" />
    <framepos name="box2-2" objtype="site" objname="box2-2" />
    <framepos name="box2-3" objtype="site" objname="box2-3" />
    <framepos name="box2-4" objtype="site" objname="box2-4" />
    <framepos name="box3-1" objtype="site" objname="box3-1" />
    <framepos name="box3-2" objtype="site" objname="box3-2" />
    <framepos name="box3-3" objtype="site" objname="box3-3" />
    <framepos name="box3-4" objtype="site" objname="box3-4" />
    <framepos name="box4-1" objtype="site" objname="box4-1" />
    <framepos name="box4-2" objtype="site" objname="box4-2" />
    <framepos name="box4-3" objtype="site" objname="box4-3" />
    <framepos name="box4-4" objtype="site" objname="box4-4" />
    <!-- <framepos name="left_target" objtype="site" objname="target1" />
    <framepos name="right_target" objtype="site" objname="target2" /> -->
  </sensor>

  <worldbody>
    <body name="target1" pos="0.5 0.0 1.1">
      <!-- <geom name="box" type="box" size="0.1 0.30 0.1" conaffinity="0" contype="0" rgba="1 .1 .1 .1"/> -->
      <site name="box1-1" type="box" pos="0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box1-2" type="box" pos="0.075 -0.25 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
      <site name="box1-3" type="box" pos="-0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box1-4" type="box" pos="-0.075 -0.25 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
    </body>

    <body name="target2" pos="0.3 0.3 1.3" euler="0 0 0.785">
      <site name="box2-1" type="box" pos="0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box2-2" type="box" pos="0.075 -0.25 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
      <site name="box2-3" type="box" pos="-0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box2-4" type="box" pos="-0.075 -0.25 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
    </body>

    <body name="target3" pos="0.0 0.4 1.1" euler="0 0 1.57">
      <site name="box3-1" type="box" pos="0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box3-2" type="box" pos="0.075 -0.25 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
      <site name="box3-3" type="box" pos="-0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box3-4" type="box" pos="-0.075 -0.25 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
    </body>

    <body name="target4" pos="0.0 0.4 1.2" euler="0 0 1.57">
      <site name="box4-1" type="box" pos="0.075  0.35 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box4-2" type="box" pos="0.075 -0.35 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
      <site name="box4-3" type="box" pos="-0.075  0.35 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
      <site name="box4-4" type="box" pos="-0.075 -0.35 -0.14" size="0.021 0.021 0.005" rgba=".1 .1 1 .1" />
    </body>

    <!-- <body name="target2"  pos="0.4 0.0 1.1">
      <freejoint />
      <geom name="box" type="box" size="0.1 0.30 0.1" />
      <site name="box1" type="box" pos="0.075  0.25 -0.14" size="0.021 0.021 0.005" rgba="1 .1 .1 .1" />
