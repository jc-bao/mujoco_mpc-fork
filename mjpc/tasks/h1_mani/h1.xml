    <default class="left_shoulder_yaw_motor">
      <joint damping="2.0" />
      <position kp="60" ctrlrange="-1.3 4.45" forcelimited="true" forcerange="-18 18" />
    </default>
    <default class="right_shoulder_yaw_motor">
      <joint damping="2.0" />
      <position kp="60" ctrlrange="-4.45 1.3" forcelimited="true" forcerange="-18 18" />
    </default>
    <default class="elbow_motor">
      <joint damping="1.0" />
      <position kp="40" ctrlrange="-1.25 2.61" forcelimited="true" forcerange="-18 18" />
    </default>
    <default class="wrist_motor">
      <joint damping="0.5" />
      <position kp="20" />
    </default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1" density="0" />
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" group="2" />
    </default>
    <default class="foot">
      <geom type="sphere" size="0.01" condim="3" priority="1" solimp="0.9 0.95 0.006" solref="0.02 1"
        friction="1.0 0.02 0.01"/>
    <!-- default solimp 0.9 (minimum impedance) 0.95 (maximum impedance) 0.001 (paneltration size)-->
    <!-- default solref 0.02 (time constant) 1 (damping ratio)-->
    </default>
    <default class="tracking_site">
      <site type="sphere" size="0.027" rgba="1 0 0 1" group="3" />
    </default>
  </default>

