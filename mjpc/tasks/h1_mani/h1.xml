<mujoco model="h1">
  <compiler angle="radian" meshdir="." autolimits="true" />

  <default>
    <motor ctrlrange="-1 1" ctrllimited="true" />
    <joint armature="0.1" />
    <geom type="mesh" friction="0.5" />
    <default class="hip_yaw_motor">
      <joint damping="5" />
      <position kp="200" ctrlrange="-0.43 0.43" forcelimited="true" forcerange="-200 200" />
    </default>
    <default class="hip_pitch_motor">
      <joint damping="5" />
      <position kp="200" ctrlrange="-3.14 2.5" forcelimited="true" forcerange="-200 200" />
    </default>
    <default class="hip_roll_motor">
      <joint damping="5" />
      <position kp="200" ctrlrange="-0.43 0.43" forcelimited="true" forcerange="-200 200" />
    </default>
    <default class="knee_motor">
      <joint damping="6" />
      <position kp="300" ctrlrange="-0.26 2.05" forcelimited="true" forcerange="-300 300" />
    </default>
    <default class="ankle_pitch_motor">
      <joint damping="2" armature="0.03" />
      <position kp="40.0" ctrlrange="-0.87 0.52" forcelimited="true" forcerange="-60 60" />
    </default>
    <default class="ankle_roll_motor">
      <joint damping="2" armature="0.03" />
      <position kp="40.0" ctrlrange="-0.261799 0.261799" forcelimited="true" forcerange="-40 40" />
    </default>
    <default class="torso_motor">
      <joint damping="3.0" />
      <position kp="150" ctrlrange="-2.35 2.35" forcelimited="true" forcerange="-200 200" />
    </default>
    <default class="shoulder_pitch_motor">
      <joint damping="2.0" />
      <position kp="60" ctrlrange="-2.87 2.87" forcelimited="true" forcerange="-40 40" />
    </default>
    <default class="left_shoulder_roll_motor">
      <joint damping="2.0" />
      <position kp="60" ctrlrange="-0.34 3.11" forcelimited="true" forcerange="-40 40" />
    </default>
    <default class="right_shoulder_roll_motor">
      <joint damping="2.0" />
      <position kp="60" ctrlrange="-3.11 0.34" forcelimited="true" forcerange="-40 40" />
